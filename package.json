{
  "name": "malina-law-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Обновления законодательства РФ из официального портала правовой информации",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch": "node scripts/fetch.mjs",
    "check": "tsc -p tsconfig.check.json && node scripts/check.mjs",
    "smoke": "vite build --ssr scripts/smoke-entry.tsx --outDir .smoke-out --logLevel warn && node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
